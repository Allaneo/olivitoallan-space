# Copy this file to .env. Project scripts load .env automatically.

# Required for AWS deployment. Local Hugo development does not need these.
DOMAIN_NAME=example.org
STACK_NAME_PREFIX=website
AWS_REGION=us-east-1
# AWS_PROFILE=your-profile

# ACM certificate must exist in us-east-1 for CloudFront.
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000

# Optional production settings.
ROBOTS_POLICY_MODE=Indexable
GOOGLE_VERIFICATION_CODE=

# Local Hugo development overrides.
HUGO_PORT=1313
HUGO_BIND=127.0.0.1
HUGO_START_TIMEOUT=10
HUGO_BUILD_TIMEOUT=60
HUGO_STOP_TIMEOUT=5

